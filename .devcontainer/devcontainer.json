{
	"name": "Apuntador Full Stack (Python + Rust)",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				// Python
				"ms-python.python",
				"ms-python.vscode-pylance",
				"charliermarsh.ruff",
				"ms-python.debugpy",
				"ms-python.mypy-type-checker",
				
				// Rust
				"rust-lang.rust-analyzer",
				"vadimcn.vscode-lldb",
				"serayuzgur.crates",
				"tamasfe.even-better-toml",
				"dustypomerleau.rust-syntax",
				
				// General
				"GitHub.copilot",
				"GitHub.copilot-chat",
				"editorconfig.editorconfig",
				"ms-azuretools.vscode-docker",
				"ms-vscode-remote.remote-containers",
				"eamodio.gitlens",
				"hashicorp.terraform",
				"redhat.vscode-yaml",
				"usernamehw.errorlens",
				"gruntfuggly.todo-tree"
			],
			"settings": {
				// Python
				"python.defaultInterpreterPath": "${workspaceFolder}/python/.venv/bin/python",
				"python.terminal.activateEnvironment": false,
				"python.testing.pytestEnabled": true,
				"python.testing.unittestEnabled": false,
				"python.testing.pytestArgs": ["python/tests"],
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff",
					"editor.formatOnSave": true,
					"editor.codeActionsOnSave": {
						"source.fixAll": "explicit",
						"source.organizeImports": "explicit"
					}
				},
				"ruff.enable": true,
				"ruff.organizeImports": true,
				"ruff.fixAll": true,
				"mypy-type-checker.importStrategy": "fromEnvironment",
				
				// Rust
				"rust-analyzer.check.command": "clippy",
				"rust-analyzer.cargo.features": "all",
				"rust-analyzer.checkOnSave": true,
				"[rust]": {
					"editor.defaultFormatter": "rust-lang.rust-analyzer",
					"editor.formatOnSave": true
				},
				
				// Files
				"files.exclude": {
					"**/__pycache__": true,
					"**/*.pyc": true,
					"**/target": true,
					"**/.pytest_cache": true,
					"**/.mypy_cache": true,
					"**/.ruff_cache": true
				}
			}
		}
	},
	"remoteUser": "vscode",
	"initializeCommand": "mkdir -p ${localWorkspaceFolder}/python/.venv ~/.aws ~/.ssh && touch ~/.gitconfig",
	"mounts": [
		"source=${localWorkspaceFolder}/python/.venv,target=/workspaces/apuntador-backend/python/.venv,type=bind,consistency=cached",
		"source=${env:HOME}/.aws,target=/home/vscode/.aws,type=bind,consistency=cached",
		"source=${env:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached",
		"source=${env:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
	],
	"remoteEnv": {
		"AWS_PROFILE": "default",
		"AWS_REGION": "eu-west-1",
		"GIT_AUTHOR_NAME": "impalah",
		"GIT_AUTHOR_EMAIL": "impalah@gmail.com",
		"GIT_COMMITTER_NAME": "impalah",
		"GIT_COMMITTER_EMAIL": "impalah@gmail.com"
	},
	"forwardPorts": [8000, 8001],
	"portsAttributes": {
		"8000": {
			"label": "Python/FastAPI Backend",
			"onAutoForward": "notify"
		},
		"8001": {
			"label": "Rust/Axum Backend",
			"onAutoForward": "notify"
		}
	},
	"postCreateCommand": "bash .devcontainer/post-create.sh"
}
